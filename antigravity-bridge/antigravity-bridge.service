[Unit]
Description=Antigravity / agy OpenAI REST API Bridge Server
After=network.target

[Service]
Type=simple
User=attasit
WorkingDirectory=/home/attasit/antigravity-bridge
ExecStart=/usr/bin/python3 /home/attasit/antigravity-bridge/antigravity_bridge.py --port 8000
Restart=always
RestartSec=5
Environment=PATH=/home/attasit/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
